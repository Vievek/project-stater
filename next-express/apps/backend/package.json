{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src/**/*.ts --exec \"npx ts-node\" src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "analyze:complexity": "ts-node --project scripts/tsconfig.json scripts/check-complexity.ts",
    "analyze:di": "ts-node --project scripts/tsconfig.json scripts/find-di.ts",
    "analyze:srp": "ts-node --project scripts/tsconfig.json scripts/check-srp.ts",
    "analyze:ocp": "ts-node --project scripts/tsconfig.json scripts/check-ocp.ts",
    "analyze:lsp": "ts-node --project scripts/tsconfig.json scripts/check-lsp.ts",
    "analyze:isp": "ts-node --project scripts/tsconfig.json scripts/check-isp.ts",
    "analyze:all": "pnpm run analyze:complexity && pnpm run analyze:srp && pnpm run analyze:ocp && pnpm run analyze:lsp && pnpm run analyze:isp && pnpm run analyze:di",
    "generate": "ts-node --project scripts/tsconfig.json scripts/generator_scripts/generate_module.ts",
    "sync-types": "ts-node --project scripts/tsconfig.json scripts/generator_scripts/sync_types.ts",
    "sync-schemas": "ts-node --project scripts/tsconfig.json scripts/generator_scripts/sync_schemas.ts",
    "sync-factories": "ts-node --project scripts/tsconfig.json scripts/generator_scripts/sync_factories.ts",
    "sync-query-config": "ts-node --project scripts/tsconfig.json scripts/generator_scripts/sync_query_config.ts",
    "sync": "pnpm run generate && pnpm run sync-types && pnpm run sync-schemas && pnpm run sync-factories && pnpm run sync-query-config"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}